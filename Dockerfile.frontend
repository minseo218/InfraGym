FROM node:22-bookworm-slim AS builder

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci --include=dev

COPY . .

ARG NEXT_PUBLIC_INFRAGYM_API_URL=http://localhost:8000
ENV NEXT_PUBLIC_INFRAGYM_API_URL=${NEXT_PUBLIC_INFRAGYM_API_URL}

RUN npm run build

FROM node:22-bookworm-slim AS runtime

ENV NODE_ENV=production
ENV HOST=0.0.0.0
ENV PORT=3000

WORKDIR /app
COPY --from=builder /app/dist/standalone ./

USER node
EXPOSE 3000
CMD ["node", "server.js"]
