      },
      "description": "0=baseline, 1=traffic surge, 2=pool exhaustion, 3=retry storm, 4=recovered",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [
            {
              "options": {
                "0": {
                  "color": "green",
                  "text": "Baseline"
                },
                "1": {
                  "color": "yellow",
                  "text": "Traffic surge"
                },
                "2": {
                  "color": "orange",
                  "text": "Pool exhausted"
                },
                "3": {
                  "color": "red",
                  "text": "Retry storm"
                },
                "4": {
                  "color": "green",
                  "text": "Recovered"
                }
              },
              "type": "value"
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1
              },
              {
                "color": "red",
                "value": 2
              },
              {
                "color": "green",
                "value": 4
              }
            ]
          }
        },
        "overrides": []
